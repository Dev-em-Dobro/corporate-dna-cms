# Copy to .env.test.local (gitignored) to enable the integration suites.
#
# EVERYTHING here must point at a DEDICATED, DISPOSABLE test environment —
# its own Supabase project and database. NEVER the shared/production project:
# the suites create users, send real emails (built-in SMTP allows 2/hour
# project-wide) and consume MFA verifications (15/hour per IP, shared by the
# whole office network). Against the real project a test run can lock actual
# editors out for an hour.
#
# Without this file (or without SUPABASE_TEST_PROJECT="true") every
# integration suite skips; unit tests always run.

# Explicit declaration that this target is disposable. The suites refuse to
# run without it.
SUPABASE_TEST_PROJECT="true"

# Supavisor transaction mode (6543) of the TEST project.
DATABASE_URL="postgres://user:password@host:6543/postgres?sslmode=require"
# Session mode (5432) of the TEST project — migrations.
DIRECT_URL="postgres://user:password@host:5432/postgres?sslmode=require"

NEXT_PUBLIC_SUPABASE_URL="https://<TEST-project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"

PREVIEW_TOKEN_SECRET="any-test-secret"

# --- Database (Supabase Postgres) ---
# Supavisor transaction mode (port 6543) — what the app uses at runtime.
DATABASE_URL="postgres://user:password@host:6543/db?sslmode=require"

# --- Preview tokens ---
# Signs short-lived draft-preview links. NOT user auth — that is Supabase's job.
# NOTE: AUTH_SECRET is retired from this file, but must STAY in the deployed
# environment until the rollback window closes — rolling back restores the old
# auth stack, which needs it.
PREVIEW_TOKEN_SECRET="separate-secret-for-signed-preview-tokens"

# --- Read API (site-facing) ---
# Shared key the marketing site sends as x-api-key to the published read API.
READ_API_KEY="long-random-read-key"

# --- Revalidation webhook (CMS -> site) ---
WEBHOOK_SIGNING_KEY="hmac-key-shared-with-the-site-revalidation-endpoint"

# --- Media (Bunny.net) ---
BUNNY_STORAGE_KEY="bunny-storage-zone-password"
BUNNY_STORAGE_ZONE="corporate-dna-media"
BUNNY_CDN_URL="https://corporate-dna.b-cdn.net"

# --- Transactional email (Resend) ---
RESEND_API_KEY="re_xxx"

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx  # server-only, NEVER NEXT_PUBLIC_"
DIRECT_URL="postgres://...:5432/postgres  # direct conn: migrations + pg_dump"
